# OS
.DS_Store
Thumbs.db

# ─── Student data — must never reach a public repo ───────────────────────────
# Commit only the header-only templates; keep filled copies as *.local.csv.
/tracking/students.local.csv
/tracking/attendance.local.csv
# Derived homework status lists student usernames — regenerate it, don't publish it.
/tracking/hw_status.csv
/tracking/progress.html
/tracking/progress_files/

# _freeze/ is committed (it caches expensive model renders), but its site_libs/ subdir is
# 5+ MB of vendored JS that Quarto regenerates from its own install on every render.
/website/_freeze/site_libs/
